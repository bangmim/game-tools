# 로컬 개발/프로덕션 모두에서 사용하는 환경변수 예시.
# 실제 값은 `.env.local` (gitignored) 또는 Netlify 대시보드 Environment variables에 등록.

# 사이트 URL (production에서는 Netlify 대시보드에 등록된 값이 사용됨)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX).
# analytics.google.com → 속성 생성 후 발급받은 ID를 넣으면 GA 스크립트가 활성화됨.
# 미설정이면 GA 스크립트 렌더되지 않음 (로컬 개발 기본값).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 개인용 GA4 대시보드 — 아래 값은 브라우저 번들에 포함되지 않는 서버 전용 값입니다.
# Netlify Dashboard > Site configuration > Environment variables에만 등록하세요.
# GA4 속성 ID (관리 > 속성 세부정보의 숫자 값, 예: 558193100)
GA4_PROPERTY_ID=

# Google Cloud 서비스 계정 JSON의 client_email
GA4_SERVICE_ACCOUNT_EMAIL=

# Google Cloud 서비스 계정 JSON의 private_key. Netlify에서는 JSON 값의 \n 표기를 유지해 붙여넣습니다.
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# /admin/analytics/에서 입력할 충분히 긴 임의의 접근 암호
GA4_DASHBOARD_ACCESS_TOKEN=
