# 로컬 개발/프로덕션 모두에서 사용하는 환경변수 예시.
# 실제 값은 `.env.local` (gitignored) 또는 Netlify 대시보드 Environment variables에 등록.

# 사이트 URL (production에서는 Netlify 대시보드에 등록된 값이 사용됨)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX).
# analytics.google.com → 속성 생성 후 발급받은 ID를 넣으면 GA 스크립트가 활성화됨.
# 미설정이면 GA 스크립트 렌더되지 않음 (로컬 개발 기본값).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
